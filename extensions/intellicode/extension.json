{
  "id": "axiom.intellicode",
  "name": "Axiom IntelliCode",
  "version": "1.2.0",
  "description": "Autocompletado inteligente local avanzado para AxiomCode: indexación multiarchivo configurable, contexto n-gram de hasta 3 tokens, ranking por alcance y archivo activo, miembros, ghost text y perfiles de memoria adaptativos.",
  "publisher": "AxiomCode",
  "installedByDefault": false,
  "keywords": [
    "ai",
    "autocomplete",
    "intellisense",
    "local",
    "javascript",
    "typescript",
    "python",
    "java",
    "rust",
    "go",
    "multi-file",
    "project-index",
    "ghost-text",
    "local-ai",
    "performance",
    "scope-aware",
    "active-file",
    "adaptive-memory"
  ],
  "contributes": {
    "rendererRuntime": {
      "entry": "runtime.js",
      "global": "AxiomIntelliCode",
      "activation": "startup"
    },
    "commands": [
      {
        "id": "intellicode.status",
        "title": "Axiom IntelliCode: Estado",
        "method": "status"
      },
      {
        "id": "intellicode.rebuild",
        "title": "Axiom IntelliCode: Reindexar proyecto",
        "method": "rebuild"
      },
      {
        "id": "intellicode.toggle",
        "title": "Axiom IntelliCode: Activar/Pausar",
        "method": "toggle"
      },
      {
        "id": "intellicode.clear",
        "title": "Axiom IntelliCode: Limpiar y reconstruir aprendizaje",
        "method": "clear"
      },
      {
        "id": "intellicode.profile",
        "title": "Axiom IntelliCode: Cambiar perfil de memoria",
        "method": "profile"
      },
      {
        "id": "intellicode.projectIndex",
        "title": "Axiom IntelliCode: Activar/Desactivar índice de proyecto",
        "method": "projectIndex"
      }
    ]
  }
}

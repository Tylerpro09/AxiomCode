{
  "id": "axiom.intellicode",
  "name": "Axiom IntelliCode",
  "version": "1.0.1",
  "description": "Autocompletado inteligente local creado desde cero para AxiomCode. Aprende del código abierto en el editor, combina contexto n-gram, símbolos y plantillas por lenguaje, sin nube ni telemetría.",
  "publisher": "AxiomCode",
  "installedByDefault": false,
  "keywords": [
    "ai",
    "autocomplete",
    "intellisense",
    "local",
    "javascript",
    "typescript",
    "python",
    "java",
    "rust",
    "go"
  ],
  "contributes": {
    "rendererRuntime": {
      "entry": "runtime.js",
      "global": "AxiomIntelliCode",
      "activation": "startup"
    },
    "commands": [
      {
        "id": "intellicode.status",
        "title": "Axiom IntelliCode: Estado",
        "method": "status"
      },
      {
        "id": "intellicode.rebuild",
        "title": "Axiom IntelliCode: Reconstruir modelo local",
        "method": "rebuild"
      }
    ]
  }
}
